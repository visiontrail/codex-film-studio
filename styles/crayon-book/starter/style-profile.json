{
  "id": "crayon-book",
  "width": 1920,
  "height": 1080,
  "background": "#f4efe3",
  "ink": "#343258",
  "accent": "#c75043",
  "secondary": "#5888ae",
  "font": "Gaegu",
  "wax": {
    "softForms": true,
    "pigmentLift": 0.045,
    "pigmentResidue": 0.24,
    "hatchOverlap": 0.5,
    "hatchGesture": 1,
    "hatchPressureDrift": 1,
    "strokeOcclusion": true,
    "formedHatching": true,
    "brokenHatching": 1,
    "organicContours": true,
    "contourPressure": 0.84,
    "protectSmallMarks": true,
    "edgeScumble": 1
  },
  "paper": {
    "reliefGain": 1.075,
    "toothScale": 1.75
  },
  "desk": {
    "layered": true,
    "handGrain": 0.6,
    "fibreDetail": 1,
    "dryScumble": 0.5,
    "meander": true,
    "wear": 1
  },
  "pageShape": {
    "edgeRise": 0.68,
    "depthEase": 0.65,
    "hingeBend": 0.12
  }
}
