  "shots": [
    {
      "id": "L01",
      "scene": "orbit",
      "text": "First time in Singapore? Leave some room in the plan. Give three days to three routes.",
      "language": "en",
      "start": 0,
      "end": 228,
      "duration": 228,
      "audio_start": 24,
      "audio_duration": 4.84
    },
    {
      "id": "L02",
      "scene": "arrival",
      "text": "Changi is in the east. The waterfront sights are to the south. Drop your bags, then begin at Marina Bay.",
      "language": "en",
      "start": 228,
      "end": 420,
      "duration": 192,
      "audio_start": 248,
      "audio_duration": 6.24
    },
    {
      "id": "L03",
      "scene": "bay",
      "text": "On day one, follow the waterfront: the Merlion, Marina Bay Sands, and Gardens by the Bay.",
      "language": "en",
      "start": 420,
      "end": 612,
      "duration": 192,
      "audio_start": 440,
      "audio_duration": 5.12
    },
    {
      "id": "L04",
      "scene": "gardens",
      "text": "See the skyline by day, and save the Supertrees for evening. Keep indoor sights for the hottest hours.",
      "language": "en",
      "start": 612,
      "end": 810,
      "duration": 198,
      "audio_start": 632,
      "audio_duration": 6.6
    },
    {
      "id": "L05",
      "scene": "chinatown",
      "text": "On day two, eat your way through the historic districts. Start with Chinatown shophouses, then a meal at Maxwell Food Centre.",
      "language": "en",
      "start": 810,
      "end": 1025,
      "duration": 215,
      "audio_start": 830,
      "audio_duration": 7.28
    },
    {
      "id": "L06",
      "scene": "districts",
      "text": "Continue to Little India, then Kampong Glam. Sultan Mosque and Haji Lane fit into the same walk.",
      "language": "en",
      "start": 1025,
      "end": 1217,
      "duration": 192,
      "audio_start": 1045,
      "audio_duration": 5.68
    },
    {
      "id": "L07",
      "scene": "transit",
      "text": "Take the metro between districts, and walk within them. Leave time for side streets, instead of another taxi ride.",
      "language": "en",
      "start": 1217,
      "end": 1412,
      "duration": 195,
      "audio_start": 1237,
      "audio_duration": 6.44
    },
    {
      "id": "L08",
      "scene": "sentosa",
      "text": "Day three belongs to Sentosa. From HarbourFront, head through VivoCity for the Sentosa Express, or walk across the boardwalk.",
      "language": "en",
      "start": 1412,
      "end": 1632,
      "duration": 220,
      "audio_start": 1432,
      "audio_duration": 7.48
    },
    {
      "id": "L09",
      "scene": "island",
      "text": "Choose one focus: beach time or Universal Studios Singapore. Give the theme park room, instead of packing two days into one.",
      "language": "en",
      "start": 1632,
      "end": 1831,
      "duration": 199,
      "audio_start": 1652,
      "audio_duration": 6.64
    },
    {
      "id": "L10",
      "scene": "card",
      "text": "Contactless bank cards make transit simple. Tap in and out with the same card and payment method. Keep card and phone separate.",
      "language": "en",
      "start": 1831,
      "end": 2048,
      "duration": 217,
      "audio_start": 1851,
      "audio_duration": 7.36
    },
    {
      "id": "L11",
      "scene": "weather",
      "text": "Carry an umbrella and water. Walk early or late. Save midday for hawker centres and indoor sights, with room for a change of weather.",
      "language": "en",
      "start": 2048,
      "end": 2321,
      "duration": 273,
      "audio_start": 2068,
      "audio_duration": 9.72
    },
    {
      "id": "L12",
      "scene": "return",
      "text": "Three days. Three routes. First the bay, then the neighbourhoods, and finally, time by the sea.",
      "language": "en",
      "start": 2321,
      "end": 2513,
      "duration": 192,
      "audio_start": 2341,
      "audio_duration": 5.04
    },
    {
      "id": "END",
      "scene": "endcard",
      "start": 2513,
      "end": 2609,
      "duration": 96
    }
  ],
