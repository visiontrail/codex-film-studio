        }
      ]
    },
    {
      "id": "wake",
      "scene": "bedroom",
      "start": 192,
      "end": 432,
      "lines": [
        {
          "speaker": "leo",
          "text": "Good morning, Jojo! The farm is waiting.",
          "start": 216,
          "end": 294,
          "wav": "media/voice/aed57a626cc7b256.wav"
        },
        {
          "speaker": "jojo",
          "text": "Already? All right. I'm coming.",
          "start": 308,
          "end": 358,
          "wav": "media/voice/9f142fec07551d59.wav"
        }
      ]
    },
    {
      "id": "clothes",
      "scene": "wardrobe",
      "start": 432,
      "end": 792,
      "lines": [
        {
          "speaker": "narrator",
          "text": "What do farmers wear? A raincoat? A swimsuit? Pajamas and slippers?",
          "start": 456,
          "end": 579,
          "wav": "media/voice/fd5eea5223f9cbad.wav"
        },
        {
          "speaker": "jojo",
          "text": "Hmm. A shirt, overalls, and boots!",
          "start": 593,
          "end": 653,
          "wav": "media/voice/dceb8033d9073eb7.wav"
        }
      ]
    },
    {
      "id": "ready",
      "scene": "walk",
      "start": 792,
      "end": 987,
      "lines": [
        {
          "speaker": "narrator",
          "text": "Now they are ready. Two friends, two buckets, and a path full of possibilities.",
          "start": 816,
          "end": 945,
          "wav": "media/voice/944ea4ca5db56bc3.wav"
        }
      ]
    },
    {
      "id": "animals",
      "scene": "animals",
      "start": 987,
      "end": 1347,
      "lines": [
        {
          "speaker": "leo",
          "text": "Let's give the animals breakfast.",
          "start": 1011,
          "end": 1067,
          "wav": "media/voice/fff0d189f721335a.wav"
        },
        {
          "speaker": "jojo",
          "text": "Which ones? Cows? Horses? Pigs? Rabbits? Chickens? Goats? Ducks?",
          "start": 1081,
          "end": 1214,
          "wav": "media/voice/80e13ba69baf2ab5.wav"
        }
      ]
    },
    {
      "id": "feed",
      "scene": "feeding",
      "start": 1347,
      "end": 1611,
      "lines": [
        {
          "speaker": "leo",
          "text": "Every one of them!",
          "start": 1371,
          "end": 1408,
          "wav": "media/voice/a2dbda9b01d9e90d.wav"
        },
        {
          "speaker": "narrator",
          "text": "Hay for the big mouths. Grain for the little beaks. Nobody misses breakfast.",
          "start": 1422,
          "end": 1543,
          "wav": "media/voice/456875203739b874.wav"
        }
      ]
    },
    {
      "id": "milk",
      "scene": "milk",
      "start": 1611,
      "end": 1875,
      "lines": [
        {
          "speaker": "leo",
          "text": "Next, let's milk the cow.",
          "start": 1635,
          "end": 1683,
          "wav": "media/voice/d9ec33281635df9c.wav"
        },
        {
          "speaker": "narrator",
          "text": "Jojo sits very still. Little by little, the empty pail fills up.",
          "start": 1697,
          "end": 1810,
          "wav": "media/voice/f51ee36215ce8b49.wav"
        }
      ]
    },
    {
