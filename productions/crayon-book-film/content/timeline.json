      "scene": "vegetables",
      "start": 1875,
      "end": 2163,
      "lines": [
        {
          "speaker": "leo",
          "text": "Now for the vegetables.",
          "start": 1899,
          "end": 1944,
          "wav": "media/voice/2ac06f842c13a626.wav"
        },
        {
          "speaker": "jojo",
          "text": "Pumpkins? Sweet potatoes? Carrots?",
          "start": 1958,
          "end": 2024,
          "wav": "media/voice/6e565eb370958477.wav"
        },
        {
          "speaker": "leo",
          "text": "Pumpkins and carrots, please.",
