#!/usr/bin/env python3
"""Wait for any existing FFmpeg before starting our own invocation.

The advisory lock serializes this production's invocations. External jobs are
observed through the process table; their files, priorities and processes are
never altered. An external job may still start after the check.
"""
import fcntl
import os
from pathlib import Path
import subprocess
import sys
import time

real = '/opt/homebrew/bin/ffmpeg'
lock = open('/tmp/codex-film-studio-ffmpeg.lock', 'a')
fcntl.flock(lock, fcntl.LOCK_EX)
announced = False
while True:
    rows = subprocess.check_output(['ps', '-axo', 'pid=,comm='], text=True).splitlines()
    active = []
    for row in rows:
        parts = row.strip().split(None, 1)
        if len(parts) == 2 and Path(parts[1]).name == 'ffmpeg':
            active.append(parts[0])
    if not active:
        break
    if not announced:
        print('Waiting for existing FFmpeg PID(s): ' + ', '.join(active), file=sys.stderr, flush=True)
        announced = True
    time.sleep(2)
if announced:
    print('Existing FFmpeg finished; starting this production invocation.', file=sys.stderr, flush=True)
try:
    result = subprocess.run([real, *sys.argv[1:]])
except KeyboardInterrupt:
    sys.exit(130)
sys.exit(result.returncode)
